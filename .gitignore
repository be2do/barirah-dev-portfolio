<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Barirah Jamal Almhasy | Creative Portfolio</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #FAF6EF;
            --primary-color: #35523A;
            --border-color: #333333;
        }

        body { 
            background-color: var(--bg-color); 
            font-family: 'Inter', sans-serif; 
            color: var(--primary-color);
            background-image: radial-gradient(#e0ddd7 1.5px, transparent 1.5px);
            background-size: 24px 24px;
        }

        .font-brand { font-family: 'Fredoka', sans-serif; }

        /* Sticker UI Elements */
        .sticker-card { 
            background: #ffffff; 
            border: 3.5px solid var(--border-color); 
            box-shadow: 7px 7px 0px 0px var(--border-color); 
            border-radius: 24px; 
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .sticker-card:hover { 
            transform: translateY(-6px) rotate(-0.5deg); 
            box-shadow: 10px 10px 0px 0px var(--border-color);
        }

        .sticker-badge { 
            border: 2px solid var(--border-color); 
            padding: 0.5rem 1.2rem; 
            border-radius: 50px; 
            font-weight: 700;
            background: white;
            box-shadow: 3px 3px 0px 0px var(--border-color);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .sticker-badge:hover {
            transform: scale(1.08) rotate(2deg);
        }

        .folder-tab {
            clip-path: polygon(0 0, 40% 0, 50% 15px, 100% 15px, 100% 100%, 0 100%);
        }
    </style>
</head>
<body class="p-4 md:p-10 max-w-7xl mx-auto">

    <!-- Floating Navigation -->
    <nav class="sticky top-6 z-50 mb-12">
        <div class="sticker-card bg-white/90 backdrop-blur-md px-6 py-4 flex justify-between items-center max-w-4xl mx-auto">
            <span class="font-brand font-bold text-xl md:text-2xl text-[#35523A]">بريرة المحسي ✦</span>
            <div class="hidden md:flex gap-6 font-semibold text-sm">
                <a href="#about" class="hover:text-[#c4607a] transition">عني</a>
                <a href="#education" class="hover:text-[#c4607a] transition">التعليم</a>
                <a href="#experience" class="hover:text-[#c4607a] transition">الخبرات</a>
                <a href="#projects" class="hover:text-[#c4607a] transition">المشاريع</a>
                <a href="#skills" class="hover:text-[#c4607a] transition">المهارات</a>
