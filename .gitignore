    <!-- HERO SECTION -->
    <header id="about" class="grid md:grid-cols-12 gap-8 items-center mb-16">
        <div class="md:col-span-8 sticker-card p-8 md:p-12 bg-[#FFF3BF]">
            <div class="inline-block bg-white border-2 border-black rounded-full px-4 py-1 text-sm font-bold mb-4 shadow-[2px_2px_0px_0px_#000]">
